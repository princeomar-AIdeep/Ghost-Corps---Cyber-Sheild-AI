# ─────────────────────────────────────────────────────────────────────────────
# CYBER-AGENT AI — Backend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────
# ── Server ────────────────────────────────────────────────────────────────────
# Port the Express server listens on.
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Full MongoDB Atlas connection string.
# Obtain from: https://cloud.mongodb.com → Cluster → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Default: http://localhost:5173 (Vite dev server)
# For production add your deployed frontend URL.
CORS_ORIGINS=http://localhost:5173

# ── Node environment ──────────────────────────────────────────────────────────
# development | production | test
# If omitted, the backend defaults to production (and requires a strong JWT_SECRET).
NODE_ENV=development

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Window in milliseconds (default 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per window per IP (default 200)
RATE_LIMIT_MAX=200

# ── JWT (Phase 3 — Authentication) ───────────────────────────────────────────
# Production: exactly 64 hexadecimal characters from a cryptographically secure random source.
# Format checks reject common weak patterns but cannot prove how a value was generated.
# The example value below is a development placeholder and is rejected in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
# Token expiry in vercel zeit/ms notation (e.g. 7d, 1h, 30m)
JWT_EXPIRES_IN=7d
# Optional. If set, tokens must include this issuer/audience.
# JWT_ISSUER=cyber-agent-ai
# JWT_AUDIENCE=cyber-agent-web
# AUTH_RATE_LIMIT_MAX=10

# ── Antivirus scanner (ClamAV daemon) ────────────────────────────────────────
# Codespaces Compose publishes the daemon on loopback; deployments should use
# a private network address and never expose clamd TCP port 3310 publicly.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=120000
CLAMAV_MAX_DEFINITION_AGE_HOURS=48
CLAMAV_MAX_CONCURRENT_SCANS=2

# ── AI Providers ──────────────────────────────────────────────────────────────
# Keep provider credentials on the backend only; never use VITE_ variables.
# Chat uses Gemini only and requires GEMINI_API_KEY.
# Coding suggestions and report summaries may use OpenAI when Gemini is absent.
# Get a Gemini key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=replace_with_your_gemini_api_key
# Gemini API model IDs; defaults are currently available according to Google's model catalog.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_REQUEST_TIMEOUT_MS=30000
# Explicit, verified fallback used only when the default model returns a retryable
# quota/service error or times out; responses include the actual model used.
# Optional comma-separated generateContent model IDs the user may select.
# Only listed IDs are accepted; the default is always GEMINI_MODEL.
# Official catalog examples: gemini-3.8-flash, gemini-3.6-flash, gemini-3.5-flash-lite
# GEMINI_ALLOWED_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# Reserved for a separately implemented and credential-verified Live API session.
# Live audio is not provided by generateContent chat.
GEMINI_LIVE_MODEL=gemini-3.8-live
# OpenAI is only for coding suggestions/report summaries; it is not a chat fallback.
# Get a key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=...

# ── GitHub App user authorization ────────────────────────────────────────────
# Create a GitHub OAuth App or a GitHub App with user authorization enabled.
# Enable user authorization and register the exact backend callback URL:
#   https://<your-backend-host>/api/github/callback
# This OAuth flow uses the App client ID/secret; it does not need the App private key.
# Set the exact HTTPS frontend dashboard return URL (loopback HTTP is allowed in development):
#   https://<your-frontend-host>/dashboard
# Values below are placeholders. Set real values only in the ignored backend/.env.
GITHUB_CLIENT_ID=your-github-app-client-id
GITHUB_CLIENT_SECRET=replace_with_github_app_client_secret
GITHUB_CALLBACK_URL=https://your-backend-host.example/api/github/callback
GITHUB_DASHBOARD_URL=https://your-frontend-host.example/dashboard
# Generate an independent 32-byte key and encode as 64 hexadecimal characters.
# Keep this stable and backed up securely; changing it prevents decrypting saved tokens.
GITHUB_TOKEN_ENCRYPTION_KEY=replace_with_64_hex_character_key
# OAuth scopes are constrained by the backend to public_repo or repo. The default
# is public_repo; repo permits writes to private repositories and should be used
# only when the user explicitly needs private repository operations.
GITHUB_OAUTH_SCOPE=public_repo

# ── Isolated execution workers ────────────────────────────────────────────────
# Build the approved terminal image from src/modules/terminal/sandbox.
TERMINAL_SANDBOX_IMAGE=cyber-shield-terminal:node22
# Preview supports only the pinned Vite/React image built from its sandbox folder.
PREVIEW_SANDBOX_IMAGE=cyber-shield-preview:vite6
# Public backend origin used to create capability-scoped preview URLs.
PREVIEW_PUBLIC_BASE_URL=https://your-backend-host.example
# Must name an operator-managed Docker network with egress filtering enforced.
# Do not use a default bridge without firewall/network policy preventing access
# to localhost, RFC1918, link-local/metadata, and backend/database services.
PREVIEW_DOCKER_NETWORK=preview-egress-filtered
# Explicit operator assertion that the network's egress controls were reviewed.
PREVIEW_EGRESS_POLICY_CONFIRMED=false

# ── Email / SMTP (Pen-drive alerts, OTP, Security Monitor notifications) ──────
# Required SMTP settings for: USB threat email alerts, OTP-based auth, and scan alerts.
# Any SMTP provider works (Gmail, SendGrid, Outlook, Mailtrap, etc.)
# SMTP_HOST, SMTP_USER, and SMTP_PASS are required. SMTP_PORT defaults to 587.
# SMTP_FROM is optional and defaults to SMTP_USER.
#
# Gmail quick-start:
#   1. Enable 2FA on your Google account
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Use that 16-char password as SMTP_PASS (NOT your normal Gmail password)
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
# "From" address shown in sent emails (defaults to SMTP_USER if omitted)
# SMTP_FROM="Cyber-Agent AI <your-email@gmail.com>"

# Alert recipient — email address that receives USB and scan threat alerts
ALERT_EMAIL=your-email@gmail.com

# ── OTP / Authentication flags ────────────────────────────────────────────────
# Set to "true" to restrict registration/login to @gmail.com addresses only
# REQUIRE_GMAIL=true

# Set to "true" to require OTP verification on new user registration
# REQUIRE_OTP_REGISTER=true

# Set to "true" to require OTP verification on every login
# REQUIRE_OTP_LOGIN=true

# OTP expiry in minutes (default: 10)
# OTP_EXPIRY_MINUTES=10
